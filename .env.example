# Certificate Studio temporary administrator access.
# Use a unique password of at least 12 characters.
PSA_ADMIN_PASSWORD=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters and must not match the admin password.
PSA_SESSION_SECRET=

# Supabase will be connected in the final persistence phase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
